# --- Vercel only (Option B in the README) -------------------------------
# Not needed if you're running via GitHub Actions alone.

# Shared secret that protects /api/check from being triggered by anyone.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Upstash Redis (free tier), used to remember which listings were already
# alerted on. Required on Vercel, because Vercel functions have no persistent
# disk. Get these from the Vercel Marketplace ("Upstash" -> create a Redis DB
# -> it auto-fills these as project env vars), or from console.upstash.com.
# Leave blank when running locally or in GitHub Actions: the app then keeps
# its state in .state/seen.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Always required ----------------------------------------------------

# Required: Gmail account used to send the alert emails.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
#    (app: "Mail", device: "Other" -> name it e.g. "yad2-alerts")
# 3. Paste the 16-character app password below (no spaces).
GMAIL_USER=                # e.g. elisestern@gmail.com
GMAIL_APP_PASSWORD=        # 16-character app password, NOT your normal Gmail password

# Optional: who receives the alert emails. Defaults to GMAIL_USER (sends to yourself).
ALERT_EMAIL_TO=

# Optional overrides:
# Yad2 search URL to poll. Build/refine this yourself on yad2.co.il (set
# location, radius, price, rooms, etc.) and paste the resulting URL here —
# the app adds maxPrice/pagination and a geo-distance filter on top of
# whatever you give it. Defaults to the Yoav regional council area
# (topArea=41, area=99), which is centered on Kfar HaRif.
YAD2_SEARCH_URL=https://www.yad2.co.il/realestate/rent?topArea=41&area=99

MAX_RENT=5500
RADIUS_KM=20
MAX_PAGES=2
